<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="TailwindGeneratorBuild_Imported" BeforeTargets="Build">
        <Message Importance="high" Text="Soenneker.Quark.Gen.Tailwind targets imported from: $(MSBuildThisFileFullPath)" />
    </Target>

    <PropertyGroup>
        <!-- NuGet package: DLL next to targets or in buildTransitive -->
        <_BuildTasksDir Condition="Exists('$(MSBuildThisFileDirectory)Soenneker.Quark.Gen.Tailwind.BuildTasks.dll')">$(MSBuildThisFileDirectory)</_BuildTasksDir>
        <_BuildTasksDir Condition="'$(_BuildTasksDir)'=='' and Exists('$(MSBuildThisFileDirectory)..\buildTransitive\Soenneker.Quark.Gen.Tailwind.BuildTasks.dll')">$(MSBuildThisFileDirectory)..\buildTransitive\</_BuildTasksDir>
        <!-- ProjectReference: BuildTasks project output (e.g. bin/Debug or bin/Release) -->
        <_BuildTasksDir Condition="'$(_BuildTasksDir)'=='' and Exists('$(MSBuildThisFileDirectory)..\Soenneker.Quark.Gen.Tailwind.BuildTasks\bin\$(Configuration)\Soenneker.Quark.Gen.Tailwind.BuildTasks.dll')">$(MSBuildThisFileDirectory)..\Soenneker.Quark.Gen.Tailwind.BuildTasks\bin\$(Configuration)\</_BuildTasksDir>
        <BuildTasksDllPath Condition="'$(BuildTasksDllPath)'=='' and '$(_BuildTasksDir)'!=''">$(_BuildTasksDir)Soenneker.Quark.Gen.Tailwind.BuildTasks.dll</BuildTasksDllPath>
        <!-- Opt-in: set TailwindGeneratorBuildEnabled=true in projects that should generate quark-tailwind.css (e.g. an app that consumes Soenneker.Quark.Suite). -->
        <TailwindGeneratorBuildEnabled Condition="'$(TailwindGeneratorBuildEnabled)'==''">false</TailwindGeneratorBuildEnabled>
        <!-- ProjectDir with no trailing backslash for reliable Exec quoting. Fallback to MSBuildProjectDirectory when ProjectDir is empty (e.g. when building the package project itself). -->
        <_TailwindProjectDir>$([System.IO.Path]::GetDirectoryName('$(ProjectDir)x'))</_TailwindProjectDir>
        <_TailwindProjectDir Condition="'$(_TailwindProjectDir)' == ''">$(MSBuildProjectDirectory)</_TailwindProjectDir>
        <!-- Default output: wwwroot/css so consuming projects get CSS in standard static content path (override with TailwindOutput). -->
        <TailwindOutput Condition="'$(TailwindOutput)' == ''">$(_TailwindProjectDir)\wwwroot\css\quark-tailwind.css</TailwindOutput>
        <TailwindMinOutput Condition="'$(TailwindMinOutput)' == ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(TailwindOutput)')), 'quark-tailwind.min.css'))</TailwindMinOutput>
        <_TailwindOutputArg Condition="'$(TailwindOutput)' != ''"> --tailwindOutput &quot;$(TailwindOutput)&quot;</_TailwindOutputArg>
        <_TailwindManifestArg Condition="'$(TailwindManifestPath)' != ''"> --manifestPath &quot;$(TailwindManifestPath)&quot;</_TailwindManifestArg>
    </PropertyGroup>

    <!-- Runs before Build so generated CSS exists and can be included in Content for copy to output. -->
    <Target Name="RunTailwindGeneratorBuildTasks"
            BeforeTargets="Build"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(TailwindGeneratorBuildEnabled)'=='true'">

        <Message Importance="high" Text="Running Soenneker.Quark.Gen.Tailwind BuildTasks: projectDir=$(_TailwindProjectDir)" />
        <Error Condition="'$(_TailwindProjectDir)' == ''"
               Text="Soenneker.Quark.Gen.Tailwind: project directory could not be resolved (ProjectDir and MSBuildProjectDirectory are empty). Set TailwindProjectDir or build a project that has a valid project directory." />
        <Error Condition="'$(BuildTasksDllPath)'==''"
               Text="BuildTasksDllPath was not resolved. MSBuildThisFileDirectory=$(MSBuildThisFileDirectory)" />
        <Error Condition="!Exists('$(BuildTasksDllPath)')"
               Text="BuildTasks DLL not found at '$(BuildTasksDllPath)'." />

        <Exec WorkingDirectory="$(_TailwindProjectDir)"
              IgnoreExitCode="false"
              ConsoleToMSBuild="true"
              StandardOutputImportance="high"
              StandardErrorImportance="high"
              Command='dotnet exec &quot;$(BuildTasksDllPath)&quot; --projectDir &quot;$(_TailwindProjectDir)&quot;$(_TailwindOutputArg)$(_TailwindManifestArg)' />
    </Target>

    <!-- Copy generated Tailwind CSS to build output (Content pipeline may run before our target). -->
    <Target Name="IncludeGeneratedTailwindCss" AfterTargets="RunTailwindGeneratorBuildTasks">
        <PropertyGroup Condition="Exists('$(TailwindOutput)')">
            <_TailwindCssOutputDir>$(OutputPath)wwwroot\css</_TailwindCssOutputDir>
        </PropertyGroup>
        <MakeDir Directories="$(_TailwindCssOutputDir)" Condition="Exists('$(TailwindOutput)') and !Exists('$(_TailwindCssOutputDir)')" />
        <Copy SourceFiles="$(TailwindOutput)"
              DestinationFolder="$(_TailwindCssOutputDir)"
              Condition="Exists('$(TailwindOutput)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(TailwindMinOutput)"
              DestinationFolder="$(_TailwindCssOutputDir)"
              Condition="Exists('$(TailwindMinOutput)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
