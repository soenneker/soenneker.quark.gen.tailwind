<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="TailwindGeneratorBuild_Imported" BeforeTargets="Build">
        <Message Importance="high" Text="Soenneker.Quark.Gen.Tailwind targets imported from: $(MSBuildThisFileFullPath)" />
    </Target>

    <PropertyGroup>
        <!-- Select the SDK host rather than the application's RuntimeIdentifier (for example browser-wasm). -->
        <TailwindToolRuntimeIdentifier Condition="'$(TailwindToolRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</TailwindToolRuntimeIdentifier>
        <_TailwindExecutableName>Soenneker.Quark.Gen.Tailwind.BuildTasks</_TailwindExecutableName>
        <_TailwindExecutableName Condition="$([System.String]::Copy('$(TailwindToolRuntimeIdentifier)').StartsWith('win-'))">$(_TailwindExecutableName).exe</_TailwindExecutableName>
        <_TailwindNativePackagePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/native/$(TailwindToolRuntimeIdentifier)/$(_TailwindExecutableName)'))</_TailwindNativePackagePath>
        <_TailwindNativeProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native/$(TailwindToolRuntimeIdentifier)/$(_TailwindExecutableName)'))</_TailwindNativeProjectPath>
        <TailwindBuildTasksExecutablePath Condition="'$(TailwindBuildTasksExecutablePath)' == '' and Exists('$(_TailwindNativePackagePath)')">$(_TailwindNativePackagePath)</TailwindBuildTasksExecutablePath>
        <TailwindBuildTasksExecutablePath Condition="'$(TailwindBuildTasksExecutablePath)' == ''">$(_TailwindNativeProjectPath)</TailwindBuildTasksExecutablePath>

        <!-- Package-scoped names so multiple Soenneker.Quark.Gen.* packages can coexist in one project. -->
        <!-- NuGet package: DLL next to targets or in buildTransitive -->
        <!-- ProjectReference: BuildTasks project output (e.g. bin/Debug or bin/Release) -->
        <!-- Opt-in: set TailwindGeneratorBuildEnabled=true in projects that should generate quark-tailwind.css (e.g. an app that consumes Soenneker.Quark.Suite). -->
        <TailwindGeneratorBuildEnabled Condition="'$(TailwindGeneratorBuildEnabled)'==''">false</TailwindGeneratorBuildEnabled>
        <!-- ProjectDir with no trailing backslash for reliable Exec quoting. Fallback to MSBuildProjectDirectory when ProjectDir is empty (e.g. when building the package project itself). -->
        <_TailwindProjectDir>$([System.IO.Path]::GetDirectoryName('$(ProjectDir)x'))</_TailwindProjectDir>
        <_TailwindProjectDir Condition="'$(_TailwindProjectDir)' == ''">$(MSBuildProjectDirectory)</_TailwindProjectDir>
        <!-- Default output: wwwroot/css so consuming projects get CSS in standard static content path (override with TailwindOutput). -->
        <TailwindOutput Condition="'$(TailwindOutput)' == ''">$([System.IO.Path]::Combine('$(_TailwindProjectDir)', 'wwwroot', 'css', 'quark-tailwind.css'))</TailwindOutput>
        <TailwindMinOutput Condition="'$(TailwindMinOutput)' == ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(TailwindOutput)')), 'quark-tailwind.min.css'))</TailwindMinOutput>
        <_TailwindOutputArg Condition="'$(TailwindOutput)' != ''"> --tailwindOutput &quot;$(TailwindOutput)&quot;</_TailwindOutputArg>
        <_TailwindManifestArg Condition="'$(TailwindManifestPath)' != ''"> --manifestPath &quot;$(TailwindManifestPath)&quot;</_TailwindManifestArg>
        <_ShadcnThemeConfigArg Condition="'$(ShadcnThemeConfig)' != ''"> --shadcnThemeConfig &quot;$(ShadcnThemeConfig)&quot;</_ShadcnThemeConfigArg>
        <_ShadcnThemeCssFileArg Condition="'$(ShadcnThemeCssFile)' != ''"> --shadcnThemeCssFile &quot;$(ShadcnThemeCssFile)&quot;</_ShadcnThemeCssFileArg>
        <_ShadcnThemeStyleArg Condition="'$(ShadcnThemeStyle)' != ''"> --shadcnThemeStyle &quot;$(ShadcnThemeStyle)&quot;</_ShadcnThemeStyleArg>
        <_ShadcnThemeBaseColorArg Condition="'$(ShadcnThemeBaseColor)' != ''"> --shadcnThemeBaseColor &quot;$(ShadcnThemeBaseColor)&quot;</_ShadcnThemeBaseColorArg>
        <_ShadcnThemeArg Condition="'$(ShadcnTheme)' != ''"> --shadcnTheme &quot;$(ShadcnTheme)&quot;</_ShadcnThemeArg>
        <_ShadcnThemeColorArg Condition="'$(ShadcnThemeColor)' != ''"> --shadcnThemeColor &quot;$(ShadcnThemeColor)&quot;</_ShadcnThemeColorArg>
        <_ShadcnThemeChartColorArg Condition="'$(ShadcnThemeChartColor)' != ''"> --shadcnThemeChartColor &quot;$(ShadcnThemeChartColor)&quot;</_ShadcnThemeChartColorArg>
        <_ShadcnThemeFontArg Condition="'$(ShadcnThemeFont)' != ''"> --shadcnThemeFont &quot;$(ShadcnThemeFont)&quot;</_ShadcnThemeFontArg>
        <_ShadcnThemeHeadingFontArg Condition="'$(ShadcnThemeHeadingFont)' != ''"> --shadcnThemeHeadingFont &quot;$(ShadcnThemeHeadingFont)&quot;</_ShadcnThemeHeadingFontArg>
        <_ShadcnThemeSerifFontArg Condition="'$(ShadcnThemeSerifFont)' != ''"> --shadcnThemeSerifFont &quot;$(ShadcnThemeSerifFont)&quot;</_ShadcnThemeSerifFontArg>
        <_ShadcnThemeMonoFontArg Condition="'$(ShadcnThemeMonoFont)' != ''"> --shadcnThemeMonoFont &quot;$(ShadcnThemeMonoFont)&quot;</_ShadcnThemeMonoFontArg>
        <_ShadcnThemeRadiusArg Condition="'$(ShadcnThemeRadius)' != ''"> --shadcnThemeRadius &quot;$(ShadcnThemeRadius)&quot;</_ShadcnThemeRadiusArg>
        <_ShadcnThemePresetArg Condition="'$(ShadcnThemePreset)' != ''"> --shadcnThemePreset &quot;$(ShadcnThemePreset)&quot;</_ShadcnThemePresetArg>
    </PropertyGroup>

    <ItemGroup>
        <_TailwindGeneratorInputs Include="$(_TailwindProjectDir)\**\*.cs;$(_TailwindProjectDir)\**\*.razor;$(_TailwindProjectDir)\**\*.cshtml;$(_TailwindProjectDir)\**\*.html"
                                  Exclude="$(_TailwindProjectDir)\bin\**;$(_TailwindProjectDir)\obj\**;$(_TailwindProjectDir)\node_modules\**" />
        <_TailwindGeneratorInputs Include="$(_TailwindProjectDir)\tailwind\input.css;$(_TailwindProjectDir)\tailwind\quark-theme.generated.css;$(_TailwindProjectDir)\tailwind\quark-tailwind-manifest.txt;$(_TailwindProjectDir)\tailwind\quark-suite-tailwind-manifest.txt;$(_TailwindProjectDir)\tailwind\tailwind.config.js;$(_TailwindProjectDir)\tailwind\package.json;$(_TailwindProjectDir)\tailwind\package-lock.json" />
    </ItemGroup>

    <!-- Runs before Build so generated CSS exists and can be included in Content for copy to output. -->
    <Target Name="RunTailwindGeneratorBuildTasks"
            AfterTargets="RunQuarkTailwindManifestGeneratorBuildTasks"
            BeforeTargets="Build"
            Inputs="@(_TailwindGeneratorInputs);$(MSBuildProjectFullPath);$(ProjectAssetsFile);$(TailwindBuildTasksExecutablePath)"
            Outputs="$(TailwindOutput);$(TailwindMinOutput)"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(TailwindGeneratorBuildEnabled)'=='true'">

        <Message Importance="high" Text="Running Soenneker.Quark.Gen.Tailwind BuildTasks: projectDir=$(_TailwindProjectDir)" />
        <Error Condition="'$(_TailwindProjectDir)' == ''"
               Text="Soenneker.Quark.Gen.Tailwind: project directory could not be resolved (ProjectDir and MSBuildProjectDirectory are empty). Set TailwindProjectDir or build a project that has a valid project directory." />
        <Error Condition="'$(TailwindBuildTasksExecutablePath)'==''"
               Text="TailwindBuildTasksExecutablePath was not resolved. MSBuildThisFileDirectory=$(MSBuildThisFileDirectory)" />
        <Error Condition="!Exists('$(TailwindBuildTasksExecutablePath)')"
               Text="Tailwind native BuildTasks executable not found at '$(TailwindBuildTasksExecutablePath)'." />

        <!-- NuGet extraction does not preserve Unix execute permissions. -->
        <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(TailwindBuildTasksExecutablePath)&quot;" />
        <Exec WorkingDirectory="$(_TailwindProjectDir)"
              IgnoreExitCode="false"
              ConsoleToMSBuild="true"
              StandardOutputImportance="high"
              StandardErrorImportance="high"
              Command='&quot;$(TailwindBuildTasksExecutablePath)&quot; --projectDir &quot;$(_TailwindProjectDir)&quot;$(_TailwindOutputArg)$(_TailwindManifestArg)$(_ShadcnThemeConfigArg)$(_ShadcnThemeCssFileArg)$(_ShadcnThemeStyleArg)$(_ShadcnThemeBaseColorArg)$(_ShadcnThemeArg)$(_ShadcnThemeColorArg)$(_ShadcnThemeChartColorArg)$(_ShadcnThemeFontArg)$(_ShadcnThemeHeadingFontArg)$(_ShadcnThemeSerifFontArg)$(_ShadcnThemeMonoFontArg)$(_ShadcnThemeRadiusArg)$(_ShadcnThemePresetArg)' />
    </Target>

    <!-- Copy generated Tailwind CSS to build output (Content pipeline may run before our target). -->
    <Target Name="IncludeGeneratedTailwindCss" AfterTargets="RunTailwindGeneratorBuildTasks">
        <PropertyGroup Condition="Exists('$(TailwindOutput)')">
            <_TailwindCssOutputDir>$([System.IO.Path]::Combine('$(OutputPath)', 'wwwroot', 'css'))</_TailwindCssOutputDir>
        </PropertyGroup>
        <MakeDir Directories="$(_TailwindCssOutputDir)" Condition="Exists('$(TailwindOutput)') and !Exists('$(_TailwindCssOutputDir)')" />
        <Copy SourceFiles="$(TailwindOutput)"
              DestinationFolder="$(_TailwindCssOutputDir)"
              Condition="Exists('$(TailwindOutput)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(TailwindMinOutput)"
              DestinationFolder="$(_TailwindCssOutputDir)"
              Condition="Exists('$(TailwindMinOutput)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
