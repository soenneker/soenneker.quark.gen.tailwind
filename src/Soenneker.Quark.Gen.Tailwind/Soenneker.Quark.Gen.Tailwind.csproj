<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Provides source generation for Quark and Tailwind CLI</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Quark.Gen.Tailwind</AssemblyName>
        <PackageId>Soenneker.Quark.Gen.Tailwind</PackageId>
        <PackageTags>quark gen tailwind cli source generator generation tailwindgenerator externalgenerator csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.quark.gen.tailwind</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.quark.gen.tailwind</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Quark.Gen.Tailwind.targets" Pack="true" PackagePath="build\" />
        <None Include="Soenneker.Quark.Gen.Tailwind.targets" Pack="true" PackagePath="buildTransitive\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
    <PropertyGroup>
        <TailwindNativeRuntimeIdentifier Condition="'$(TailwindNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</TailwindNativeRuntimeIdentifier>
        <TailwindNativeArtifactsDir Condition="'$(TailwindNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</TailwindNativeArtifactsDir>
        <_TailwindNativeExecutable>Soenneker.Quark.Gen.Tailwind.BuildTasks</_TailwindNativeExecutable>
        <_TailwindNativeExecutable Condition="$([System.String]::Copy('$(TailwindNativeRuntimeIdentifier)').StartsWith('win-'))">$(_TailwindNativeExecutable).exe</_TailwindNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(TailwindUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(TailwindNativeSource);../Soenneker.Quark.Gen.Tailwind.BuildTasks/obj/project.assets.json"
            Outputs="$(TailwindNativeArtifactsDir)/$(TailwindNativeRuntimeIdentifier)/$(_TailwindNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Tailwind.BuildTasks/Soenneker.Quark.Gen.Tailwind.BuildTasks.csproj&quot; --configuration Release --runtime $(TailwindNativeRuntimeIdentifier) --output &quot;$(TailwindNativeArtifactsDir)/$(TailwindNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <TailwindNativeSource Include="../Soenneker.Quark.Gen.Tailwind.BuildTasks/**/*.cs;../Soenneker.Quark.Gen.Tailwind.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Quark.Gen.Tailwind.BuildTasks/bin/**;../Soenneker.Quark.Gen.Tailwind.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_TailwindRequiredRuntime Include="win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64" Condition="'$(TailwindUsePrebuiltNativeTools)' == 'true'" />
            <_TailwindNativeFile Include="$(TailwindNativeArtifactsDir)/**/*"
                                Exclude="$(TailwindNativeArtifactsDir)/**/*.pdb;$(TailwindNativeArtifactsDir)/**/*.dbg;$(TailwindNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_TailwindNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_TailwindRequiredRuntime)' != '' and !Exists('$(TailwindNativeArtifactsDir)/%(_TailwindRequiredRuntime.Identity)/Soenneker.Quark.Gen.Tailwind.BuildTasks') and !Exists('$(TailwindNativeArtifactsDir)/%(_TailwindRequiredRuntime.Identity)/Soenneker.Quark.Gen.Tailwind.BuildTasks.exe')"
               Text="Missing native tailwind tool for %(_TailwindRequiredRuntime.Identity)." />
        <Error Condition="'@(_TailwindNativeFile)' == ''" Text="Native tailwind tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
